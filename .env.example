# ============================================================
# auto-jobsearch-apply — Environment Configuration
#
# SETUP:
#   cp .env.example .env
#   Fill in your values, then run ./run.sh (or run.bat on Windows)
#
# REQUIRED fields are marked with  ← REQUIRED
# Everything else has safe defaults.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Matches the docker-compose.yml postgres container (port 5435)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/postgres   # ← REQUIRED

# ── LLM Provider ─────────────────────────────────────────────
# Choose one: claude | gemini | openai
LLM_PROVIDER=gemini                                                            # ← REQUIRED

# Anthropic (Claude) — needed when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini via Vertex AI — needed when LLM_PROVIDER=gemini
# Get your project ID from: https://console.cloud.google.com
GCP_PROJECT_ID=your-gcp-project-id                                            # ← REQUIRED for gemini
GCP_LOCATION=global                                                            # global = required for Gemini 3.x models
GOOGLE_APPLICATION_CREDENTIALS=./vertex-ai-credentials.json                   # ← REQUIRED for gemini
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# GEMINI_API_KEY=...   # only needed for AI Studio; leave blank for Vertex AI

# OpenAI — needed when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── Model selection ───────────────────────────────────────────
# Scoring = high-volume filter (cheap/fast model)
# Tailoring = quality resume generation (best model)
CLAUDE_SCORING_MODEL=claude-haiku-4-5-20251001
CLAUDE_TAILORING_MODEL=claude-sonnet-4-6

GEMINI_SCORING_MODEL=gemini-3.5-flash
GEMINI_TAILORING_MODEL=gemini-3.1-pro-preview

OPENAI_SCORING_MODEL=gpt-4o-mini
OPENAI_TAILORING_MODEL=gpt-4o

# ── Resume ───────────────────────────────────────────────────
# Path to your base resume (.docx recommended, .pdf also supported)
RESUME_PATH=resumes/base_resume.docx                                          # ← REQUIRED

# ── Applicant identity ───────────────────────────────────────
# Used by the form filler to populate ATS fields automatically
APPLICANT_FIRST_NAME=                                                          # ← REQUIRED
APPLICANT_LAST_NAME=                                                           # ← REQUIRED
APPLICANT_EMAIL=                                                               # ← REQUIRED
APPLICANT_PHONE=
APPLICANT_LINKEDIN=https://www.linkedin.com/in/yourhandle/
APPLICANT_GITHUB=https://github.com/yourusername
APPLICANT_PORTFOLIO=
APPLICANT_CITY=Bengaluru
APPLICANT_COUNTRY=India

# Password used when ATS portals (Workday, Taleo, etc.) require account creation
APPLICANT_PASSWORD=

# ── Extended applicant profile ───────────────────────────────
# The LLM uses these to answer ATS-specific screening questions
APPLICANT_YEARS_EXP=4
APPLICANT_CURRENT_EMPLOYER=Your Company
APPLICANT_CURRENT_TITLE=Software Engineer
APPLICANT_WORK_AUTH=Yes          # Yes | No | H1B | OPT | etc.
APPLICANT_VISA_NEEDED=No         # Yes | No
APPLICANT_RELOCATE=Yes           # Yes | No
APPLICANT_SALARY_EXPECT=30       # In LPA (India) or USD (International)
APPLICANT_NOTICE_PERIOD=Immediate

# ── Automation ───────────────────────────────────────────────
# WARNING: set to true to auto-click the Submit button.
# Start with false to review before submitting.
AUTO_SUBMIT=false

# ── Matching / score threshold ───────────────────────────────
# Jobs scoring below this are skipped (0–100)
MATCH_SCORE_THRESHOLD=70
# SALARY_FLOOR_INR=2000000     # skip jobs paying less than this (INR)
# SALARY_FLOOR_USD=100000      # skip jobs paying less than this (USD)

# ── India job search profile ─────────────────────────────────
INDIA_SEARCH_TERMS=software engineer, Backend Engineer, Senior Software Engineer
INDIA_LOCATIONS=Bengaluru,Hyderabad,Remote
INDIA_RESULTS_WANTED=50

# ── International remote job search ──────────────────────────
INTL_SEARCH_TERMS=software engineer
INTL_RESULTS_WANTED=50
INTL_ENABLED=true

# ── Naukri-specific filters ───────────────────────────────────
NAUKRI_SALARY_MIN_LPA=25
NAUKRI_SALARY_MAX_LPA=40
NAUKRI_WORK_MODE=any            # wfh | hybrid | office | any
NAUKRI_POSTED_DAYS=30           # 1 | 7 | 15 | 30 | 0 (any time)
NAUKRI_JOB_TYPE=fulltime        # fulltime | parttime | contract | any
# NAUKRI_CURRENT_CTC=           # e.g. 18 for 18 LPA (leave blank to skip)

# ── Portal credentials (fallback) ────────────────────────────
# Primary authentication is via saved browser session cookies.
# These are only used if a session has expired and needs re-login.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
INSTAHYRE_EMAIL=
INSTAHYRE_PASSWORD=
WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=

# ── Browser session storage ───────────────────────────────────
# Where portal login cookies are persisted between runs
SESSION_DIR=~/.auto-jobsearch/sessions

# ── Chrome profile (macOS only) ───────────────────────────────
# Run: ls "~/Library/Application Support/Google/Chrome/"
# to find your profile name (usually "Default" or "Profile N")
CHROME_PROFILE=Default

# ── Scheduler (UTC, 24h clock) ───────────────────────────────
# The nightly scrape-and-score pipeline runs at this time every day
SCRAPE_CRON_HOUR=2
SCRAPE_CRON_MINUTE=0
