# ============================================================
# auto-jobsearch-apply — Minimal Environment Configuration
# Setup: cp .env.example .env and fill in your values.
# ============================================================

# ── 1. Database ──────────────────────────────────────────────
# PostgreSQL connection URL (Required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/postgres

# ── 2. LLM Provider Configuration ───────────────────────────
# Active provider: gemini | claude | openai
LLM_PROVIDER=gemini

# Google Vertex AI Configuration (Used when LLM_PROVIDER=gemini)
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_LOCATION=global
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./vertex-ai-credentials.json

# Fallback API keys for Claude or OpenAI (Used when active)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 3. Model Selections ──────────────────────────────────────
# Scoring: cheap, fast model for high-volume sorting (e.g. gemini-3.5-flash)
# Tailoring: high-reasoning model for customized docs (e.g. gemini-3.1-pro-preview)
GEMINI_SCORING_MODEL=gemini-3.5-flash
GEMINI_TAILORING_MODEL=gemini-3.1-pro-preview

CLAUDE_SCORING_MODEL=claude-haiku-4-5-20251001
CLAUDE_TAILORING_MODEL=claude-sonnet-4-6

OPENAI_SCORING_MODEL=gpt-4o-mini
OPENAI_TAILORING_MODEL=gpt-4o

# ── 4. Candidate & Profile Data ─────────────────────────────
# Path to your base resume file
RESUME_PATH=resumes/base_resume.docx

# Personal details used by form fillers and email/DM drafters
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_LINKEDIN=https://www.linkedin.com/in/yourprofile/
APPLICANT_GITHUB=https://github.com/yourusername
APPLICANT_PORTFOLIO=
APPLICANT_CITY=Bengaluru
APPLICANT_COUNTRY=India

# Password for auto-creating ATS accounts (Workday, etc.)
APPLICANT_PASSWORD=

# ── 5. Application Safeguards & Thresholds ──────────────────
# Set to true to fully auto-submit forms (Start with false to review first)
AUTO_SUBMIT=false

# Minimum match rating (0-100) to flag jobs as approved/matched
MATCH_SCORE_THRESHOLD=70

# ── 6. Search Profiles & Scraping ───────────────────────────
# Search settings for Indian Markets (Naukri, Instahyre, etc.)
INDIA_SEARCH_TERMS=software engineer, Backend Engineer
INDIA_LOCATIONS=Bengaluru,Remote
INDIA_RESULTS_WANTED=30

# Search settings for International/Remote (BuiltIn, LinkedIn, etc.)
INTL_SEARCH_TERMS=software engineer
INTL_RESULTS_WANTED=30
INTL_ENABLED=true
