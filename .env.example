# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jobagent

# LLM — set LLM_PROVIDER to one of: claude, gemini, openai
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...

# Model overrides — separate models for scoring (high-volume filter) and tailoring (quality generation)
CLAUDE_SCORING_MODEL=claude-haiku-4-5-20251001
CLAUDE_TAILORING_MODEL=claude-sonnet-4-6
GEMINI_SCORING_MODEL=gemini-3.5-flash
GEMINI_TAILORING_MODEL=gemini-3.1-pro

# Vertex AI — service account JSON key (no gcloud CLI needed in prod)
# GCP_PROJECT_ID=your-project-id
# GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=./vertex-ai-credentials.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
OPENAI_SCORING_MODEL=gpt-4o-mini
OPENAI_TAILORING_MODEL=gpt-4o

# Automation
AUTO_SUBMIT=false

# Matching
MATCH_SCORE_THRESHOLD=70
# SALARY_FLOOR_INR=2000000
# SALARY_FLOOR_USD=100000

# India search profile
INDIA_SEARCH_TERMS=software engineer
INDIA_LOCATIONS=Bengaluru,Hyderabad,Remote
INDIA_RESULTS_WANTED=50

# International remote search profile
INTL_SEARCH_TERMS=software engineer
INTL_RESULTS_WANTED=50
INTL_ENABLED=true

# Scheduler (24h clock, UTC) — default: 2:00 AM
SCRAPE_CRON_HOUR=2
SCRAPE_CRON_MINUTE=0

# Resume — .pdf and .docx are both supported
RESUME_PATH=resumes/base_resume.pdf
